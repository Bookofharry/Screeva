{
  "name": "local-creator-recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @recorder/client && tsc -p apps/server/tsconfig.build.json",
    "start": "node dist/apps/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:faults": "node --import tsx --test tests/fault-injection.test.ts tests/chunk-ingestion.test.ts tests/chunk-pipeline.test.ts tests/chunk-transport.test.ts tests/durable-recording-engine.test.ts tests/finalization.test.ts tests/recovery.test.ts tests/recording-engine.test.ts tests/security.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:recording:five-minute": "npm run build && playwright test -c playwright.acceptance.config.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "minimatch": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@rolldown/binding-wasm32-wasi": "1.2.18",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7"
  }
}
